#!/bin/bash
# chargewatch [count] [interval] — sample charger input and battery power.
# Defaults: 3 samples, 1.5 s apart. The battery controller refreshes these
# values only every ~15 s or more, so consecutive samples often match.

count=${1:-3}
interval=${2:-1.5}

# Integer field from the ioreg dump; ioreg prints signed values as unsigned
# 64-bit, and bash arithmetic wraps them back to signed.
field() {
	local v
	v=$(grep -oE "\"$1\" ?= ?[0-9]+" <<<"$dump" | head -1 | grep -oE '[0-9]+$')
	echo $((${v:-0}))
}

printf '%-8s %8s %8s %8s %8s %9s %9s %4s %6s\n' \
	time "in V" "in A" "in W" "load W" "batt W" "batt mA" SoC "nochg"
for ((i = 1; i <= count; i++)); do
	dump=$(ioreg -rn AppleSmartBattery)
	printf '%-8s %8.2f %8.2f %8.1f %8.1f %+9.1f %+9d %3d%% %6s\n' \
		"$(date +%T)" \
		"$(bc <<<"scale=3; $(field SystemVoltageIn) / 1000")" \
		"$(bc <<<"scale=3; $(field SystemCurrentIn) / 1000")" \
		"$(bc <<<"scale=3; $(field SystemPowerIn) / 1000")" \
		"$(bc <<<"scale=3; $(field SystemLoad) / 1000")" \
		"$(bc <<<"scale=3; $(field BatteryPower) / 1000")" \
		"$(field InstantAmperage)" \
		"$(field CurrentCapacity)" \
		"$(printf '0x%x' "$(field NotChargingReason)")"
	((i < count)) && sleep "$interval"
done

echo
contract=$(pmset -g adapter | grep -E 'Wattage|Voltage|Current' | tr -s ' ' | tr '\n' ' ')
echo "adapter:${contract:- none} ${contract:+(negotiated contract)}"
pmset -g batt | tail -1 | sed -E 's/^.*\t//; s/ present: true//'
pmset -g log | grep -E 'Using (AC|Batt)' | tail -3 |
	sed -E 's/^([0-9-]+ [0-9:]+).*Using (AC|Batt)\(Charge: ([0-9]+)\).*/\1  \2 at \3%/'
